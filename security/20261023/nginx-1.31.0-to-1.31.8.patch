diff -ruN .work/nginx-1.31.0/CHANGES .work/nginx-1.31.8/CHANGES
--- .work/nginx-1.31.0/CHANGES	2026-05-13 22:34:06.000000000 +0900
+++ .work/nginx-1.31.8/CHANGES	2026-10-21 23:35:35.000000000 +0900
